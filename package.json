{
  "name": "giri-raksha-workspace",
  "version": "1.0.0",
  "description": "Giri Raksha - AI-Based Landslide Early Warning and Risk Monitoring System in NER",
  "private": true,
  "scripts": {
    "test": "cd mobile && node scripts/test-runner.js",
    "mobile": "cd mobile && npx expo start",
    "mobile:web": "cd mobile && npx expo start --web",
    "mobile:android": "cd mobile && npx expo start --android",
    "mobile:ios": "cd mobile && npx expo start --ios",
    "server": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "server:start": "cd server && npm start",
    "ml:train": ".venv/bin/python ml-service/training/train_model.py",
    "ml:serve": ".venv/bin/python ml-service/main.py"
  }
}
